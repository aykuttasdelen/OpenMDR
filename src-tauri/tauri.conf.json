{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenMD",
  "version": "1.1.0",
  "identifier": "com.openmd.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenMD",
        "label": "main",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "**/*",
          "$HOME/**",
          "$HOME/**/*",
          "$DOCUMENT/**",
          "$DOCUMENT/**/*",
          "$DOWNLOAD/**",
          "$DOWNLOAD/**/*",
          "$TEMP/**",
          "$TEMP/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "native/ocr_engine",
      "native/ocr_engine.swift"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
